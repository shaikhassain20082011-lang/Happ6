    global ai_status
    sys = """Umar Punjab ICT/SMC expert. OB FVG BOS Kill zones OTE.
Never against 4H. Wait for sweep. Patience."""
    p = f"""AI1:{ai1[:80]}
{m['4h']} {m['30m']}
FVG={m['fvg']} OB={m['ob']} Sweep={m['sweep']}
Price={m['price']:.2f} Session={m['session']}

OUTPUT:
BIAS:[LONG/SHORT/NONE]
SETUP:[name]
ENTRY:[$price]
SL:[$price]
TP:[$price]
VERDICT:[TRADE/WAIT/AVOID]"""
    result = call_groq(sys, p, 120)
    ai_status["AI8"] = "✅" if "ERR" not in result else "❌"
    return result

def ai9_super_controller(m, results):
    global ai_status

    names = ["AI1","AI2","AI3","AI4","AI5","AI6","AI7","AI8"]
    long_v = short_v = skip_v = 0
    failed = []

    for i, res in enumerate(results):
        ok = len(str(res).strip()) > 15 and "ERR" not in str(res)
        if not ok:
            failed.append(names[i])
        txt = str(res).upper()
        l   = txt.count("LONG") * 2 + txt.count("BULL")
        s   = txt.count("SHORT") * 2 + txt.count("BEAR")
        sk  = txt.count("SKIP") + txt.count("WAIT") + txt.count("AVOID")
        if sk > 2:
            skip_v  += 1
        elif l > s:
            long_v  += 1
        elif s > l:
            short_v += 1
        else:
            skip_v  += 1

    if failed:
        send_telegram(f"⚠️ AI9: {', '.join(failed)} failed. Auto backup active.")

    recent = trade_memory[-5:] if trade_memory else []
    cons = 0
    for t in reversed(recent):
        if t.get("outcome") == "LOSS":
            cons += 1
        else:
            break

    block = "NO"
    block_reason = ""

    if cons >= 2:
        block = "YES"
        block_reason = "2+ consecutive losses"
    if abs(m["funding"]) > 0.05:
        block = "YES"
        block_reason = "Extreme funding rate"
    if "PAUSE:YES" in str(results[3]).upper():
        block = "YES"
        block_reason = "AI4 risk pause"

    if long_v > short_v:
        consensus = "LONG"
    elif short_v > long_v:
        consensus = "SHORT"
    else:
        consensus = "FLAT"

    verdict = "SKIP"
    if block == "NO" and max(long_v, short_v) >= 5:
        verdict = "TRADE"
    elif block == "NO":
        verdict = "WAIT"

    discipline = "GOOD"
    if cons >= 1:
        discipline = "WARNING"
    if cons >= 2:
        discipline = "CRITICAL"

    ai_status["AI9"] = "✅"

    return (f"CONSENSUS:{consensus}\n"
            f"LONG_VOTES:{long_v} SHORT_VOTES:{short_v}\n"
            f"DISCIPLINE:{discipline}\n"
            f"VERDICT:{verdict}\n"
            f"BLOCK:{block}\n"
            f"BLOCK_REASON:{block_reason if block_reason else 'None'}\n"
            f"FAILED:{failed if failed else 'None'}")

# ============================================================
# AI VOTING
# ============================================================

def ai_vote(results):
    lv = sv = skv = 0
    for res in results:
        txt = str(res).upper()
        l   = txt.count("LONG") * 2 + txt.count("BULL")
        s   = txt.count("SHORT") * 2 + txt.count("BEAR")
        sk  = txt.count("SKIP") + txt.count("WAIT") + txt.count("AVOID")
        if sk > 2:
            skv += 1
        elif l > s:
            lv  += 1
        elif s > l:
            sv  += 1
        else:
            skv += 1

    ai9 = str(results[8]).upper()
    if "BLOCK:YES" in ai9:
        return "NONE", 0
    if "PAUSE:YES" in str(results[3]).upper():
        return "NONE", 0

    total = lv + sv + skv
    if total == 0:
        return "NONE", 0
    if lv >= 5:
        return "LONG", round(lv / total * 100)
    elif sv >= 5:
        return "SHORT", round(sv / total * 100)
    else:
        return "NONE", 0

def get_levels(results, direction, price):
    def parse(text, key):
        try:
            for sep in ["=", ":"]:
                full = key + sep
                if full.upper() in text.upper():
                    idx   = text.upper().index(full.upper())
                    chunk = text[idx + len(full):idx + len(full) + 15]
                    d     = "".join(c for c in chunk if c.isdigit() or c == ".")
                    v     = float(d[:8])
                    if 100 < v < 100000:
                        return v
        except:
            pass
        return None

    ai3 = str(results[2])
    ai8 = str(results[7])
    entry = parse(ai3, "ENTRY") or parse(ai8, "ENTRY") or price
    sl    = parse(ai3, "SL")    or parse(ai8, "SL")
    tp1   = parse(ai3, "TP1")
    tp2   = parse(ai3, "TP2")   or parse(ai8, "TP")

    if direction == "LONG":
        sl  = sl  or round(price * 0.9920, 1)
        tp1 = tp1 or round(price * 1.0130, 1)
        tp2 = tp2 or round(price * 1.0260, 1)
    else:
        sl  = sl  or round(price * 1.0080, 1)
        tp1 = tp1 or round(price * 0.9870, 1)
        tp2 = tp2 or round(price * 0.9740, 1)

    rr = round(abs(tp2 - entry) / abs(sl - entry), 2) if abs(sl - entry) > 0 else 0
    if rr < 1.5:
        return None
    return {"entry": entry, "sl": sl, "tp1": tp1, "tp2": tp2, "rr": rr}

# ============================================================
# BEAUTIFUL UNIFIED MESSAGE BUILDER
# ============================================================

def build_status_message(m, results, direction, vote_pct, levels):
    wins    = sum(1 for t in paper_history if t["outcome"] == "WIN")
    losses  = len(paper_history) - wins
    wr      = round(wins / max(len(paper_history), 1) * 100, 1)
    pnl     = round(sum(t["pnl"] for t in paper_history), 2)
    exp     = get_experience()
    balance = get_balance()
    st      = "📈" if pnl >= 0 else "📉"
    t_now   = datetime.now().strftime("%H:%M")

    ai_row = (f"AI1{ai_status['AI1']} AI2{ai_status['AI2']} AI3{ai_status['AI3']}\n"
              f"AI4{ai_status['AI4']} AI5{ai_status['AI5']} AI6{ai_status['AI6']}\n"
              f"AI7{ai_status['AI7']} AI8{ai_status['AI8']} AI9{ai_status['AI9']}")

    sess_emoji = {"ASIA": "🌏", "LONDON": "🇬🇧",
                  "NEW YORK": "🗽", "OFF-HOURS": "🌙"}
    s_emoji = sess_emoji.get(m["session"], "🌐")

    if direction == "LONG":
        dir_line = f"🟢 <b>LONG ▲</b> — {vote_pct}% confidence"
    elif direction == "SHORT":
        dir_line = f"🔴 <b>SHORT ▼</b> — {vote_pct}% confidence"
    else:
        dir_line = "⚪ <b>NO TRADE</b> — Waiting for setup"

    pos_line = "None"
    if open_position:
        pos = get_open_pos()
        lpnl = pos["pnl"] if pos else 0
        p_emoji = "📈" if lpnl >= 0 else "📉"
        pos_line = (f"{open_position['direction']} "
                    f"@ ${open_position['entry']:.1f} "
                    f"{p_emoji}${lpnl:.2f}")

    levels_line = ""
    if levels and direction != "NONE":
        levels_line = (f"\n💰 Entry: <b>${levels['entry']:.1f}</b>\n"
                       f"🛑 SL: ${levels['sl']:.1f}\n"
                       f"🎯 TP1: ${levels['tp1']:.1f}\n"
                       f"🎯 TP2: ${levels['tp2']:.1f}\n"
                       f"📐 R:R = 1:{levels['rr']}")

    msg = (f"⚡ <b>ZEUS ORACLE v7 • {t_now}</b>\n"
           f"━━━━━━━━━━━━━━━━━━\n"
           f"💹 ETH: <b>${m['price']:.2f}</b> "
           f"{s_emoji} {m['session']} "
           f"({m['chg24']:+.2f}%)\n"
           f"━━━━━━━━━━━━━━━━━━\n"
           f"🤖 <b>AI STATUS</b>\n"
           f"{ai_row}\n"
           f"━━━━━━━━━━━━━━━━━━\n"
           f"🧠 <b>DECISION</b>\n"
           f"{dir_line}"
           f"{levels_line}\n"
           f"━━━━━━━━━━━━━━━━━━\n"
           f"💼 <b>PORTFOLIO</b>\n"
           f"Balance: ${balance:.2f}\n"
           f"PnL: {st} <b>${pnl}</b>\n"
           f"WR: <b>{wr}%</b> | {wins}W/{losses}L\n"
           f"Trades(x): {trades_since_last_msg} | (y): {len(paper_history)}\n"
           f"Experience: {exp}\n"
           f"Open: {pos_line}\n"
           f"━━━━━━━━━━━━━━━━━━\n"
           f"📰 {m['news'][:60]}\n"
           f"[TESTNET FAKE MONEY]")
    return msg

# ============================================================
# TELEGRAM COMMANDS & MESSAGES
# ============================================================

def check_commands():
    global last_update_id, trades_since_last_msg
    try:
        r = requests.get(
            f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/getUpdates",
            params={"offset": last_update_id + 1, "timeout": 5},
            timeout=10)
        updates = r.json().get("result", [])
        for update in updates:
            last_update_id = update["update_id"]
            text = update.get("message", {}).get("text", "").strip()
            
            if not text:
                continue
            
            # Check for /status command (old style)
            if text.lower() == "/status":
                m = get_market_data()
                r0 = ai1_macro(m)
                r1 = ai2_technicals(m)
                r2 = ai3_confluence(m, r0, r1)
                r3 = ai4_risk(m)
                r4 = ai5_smart_money(m, r0)
                r5 = ai6_rl_coach()
                r6 = ai7_edge_master(m, r0)
                r7 = ai8_umar(m, r0)
                r8 = ai9_super_controller(m, [r0,r1,r2,r3,r4,r5,r6,r7])
                results = [r0,r1,r2,r3,r4,r5,r6,r7,r8]
                direction, vote_pct = ai_vote(results)
                levels = get_levels(results, direction, m["price"]) if direction != "NONE" else None
                msg = build_status_message(m, results, direction, vote_pct, levels)
                send_telegram(msg)
                trades_since_last_msg = 0
            
            # Check for /mistakes command (old style)
            elif text.lower() == "/mistakes":
                if not mistake_log:
                    send_telegram("✅ No mistakes yet! AIs learning...")
                else:
                    lines = ["📚 <b>AI Mistakes Learned:</b>"]
                    for mk in mistake_log[-5:]:
                        lines.append(f"❌ {mk['direction']}: {mk['reason'][:50]}")
                    send_telegram("\n".join(lines))
            
            # ANY other message goes to HASSAIN AI
            else:
                context = get_hassain_context()
                response = call_hassain_ai(text, context)
                send_telegram(f"🤖 <b>HASSAIN AI</b>:\n\n{response}")
                
    except Exception as e:
        print(f"Command error: {e}")

