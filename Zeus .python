def ai1_macro(m):
    global ai_status
    sys = "World macro analyst. Regime + direction. Be fast and decisive."
    p = f"""Price={m['price']:.2f} Funding={m['funding']:.4f}%
OI={m['oi_trend']} 24h={m['chg24']:.2f}% Session={m['session']}
{m['4h']} NEWS:{m['news'][:60]}
MISTAKES:{get_mistakes()[:60]}

OUTPUT:
REGIME:[Trend/Chop/Shock]
DIRECTION:[LONG/SHORT/NONE]
CONFIDENCE:[0-100]%"""
    result = call_groq(sys, p, 150)
    ai_status["AI1"] = "✅" if "ERR" not in result else "❌"
    return result

def ai2_technicals(m):
    global ai_status
    closes_4h = []
    try:
        k = get_klines("4h", 20)
        closes_4h = [c["c"] for c in k]
    except:
        pass
    closes_30m = []
    try:
        k = get_klines("30m", 20)
        closes_30m = [c["c"] for c in k]
    except:
        pass

    rsi_4h  = calc_rsi(closes_4h)  if closes_4h  else 50
    rsi_30m = calc_rsi(closes_30m) if closes_30m else 50
    ema_4h  = calc_ema(closes_4h, 20)  if closes_4h  else m["price"]

    direction = "NONE"
    confidence = 50

    if rsi_4h > 55 and m["price"] > ema_4h:
        direction = "LONG"
        confidence = min(90, int(rsi_4h))
    elif rsi_4h < 45 and m["price"] < ema_4h:
        direction = "SHORT"
        confidence = min(90, int(100 - rsi_4h))

    sl = round(m["price"] * 0.992, 1) if direction == "LONG" else round(m["price"] * 1.008, 1)
    tp1 = round(m["price"] * 1.013, 1) if direction == "LONG" else round(m["price"] * 0.987, 1)
    tp2 = round(m["price"] * 1.026, 1) if direction == "LONG" else round(m["price"] * 0.974, 1)

    result = (f"DIRECTION:{direction}\n"
              f"ENTRY:${m['price']:.1f}\n"
              f"SL:${sl}\nTP1:${tp1}\nTP2:${tp2}\n"
              f"RSI_4H:{rsi_4h} RSI_30M:{rsi_30m}\n"
              f"CONFIDENCE:{confidence}%")
    ai_status["AI2"] = "✅"
    return result

