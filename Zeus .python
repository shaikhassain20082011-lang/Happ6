def ai4_risk(m):
    global ai_status
    recent = trade_memory[-5:] if trade_memory else []
    cons = 0
    for t in reversed(recent):
        if t.get("outcome") == "LOSS":
            cons += 1
        else:
            break

    pause = "NO"
    reason = "OK"
    approved = "YES"

    if cons >= 2:
        pause = "YES"
        reason = "2+ consecutive losses"
        approved = "NO"
    elif abs(m["funding"]) > 0.05:
        pause = "YES"
        reason = "Extreme funding"
        approved = "NO"
    elif m["session"] == "OFF-HOURS":
        reason = "Off-hours caution"

    result = (f"PAUSE:{pause}\n"
              f"APPROVED:{approved}\n"
              f"CONS_LOSSES:{cons}\n"
              f"REASON:{reason}")
    ai_status["AI4"] = "✅"
    return result

