def get_crypto_news():
    try:
        r = requests.get(
            "https://newsapi.org/v2/everything",
            params={
                "q": "ethereum OR ETH crypto",
                "apiKey": NEWS_API_KEY,
                "pageSize": 3,
                "sortBy": "publishedAt",
                "language": "en"
            }, timeout=10)
        articles = r.json().get("articles", [])
        headlines = [
            a.get("title", "")[:60]
            for a in articles[:3]
            if a.get("title", "") and a.get("title", "") != "[Removed]"
        ]
        return " | ".join(headlines) if headlines else "No news"
    except:
        return "News failed"

# ============================================================
# MARKET DATA
# ============================================================

def get_klines(interval, limit):
    try:
        r = requests.get(
            "https://fapi.binance.com/fapi/v1/klines",
            params={"symbol": SYMBOL, "interval": interval, "limit": limit},
            timeout=10)
        return [{"o": float(c[1]), "h": float(c[2]),
                 "l": float(c[3]), "c": float(c[4]),
                 "v": float(c[5])} for c in r.json()]
    except:
        return []

def calc_ema(closes, p):
    if not closes:
        return 0
    k = 2 / (p + 1)
    ema = closes[0]
    for x in closes[1:]:
        ema = x * k + ema * (1 - k)
    return round(ema, 2)

def calc_rsi(closes, p=14):
    if len(closes) < p + 1:
        return 50
    g = [max(closes[i] - closes[i - 1], 0) for i in range(1, len(closes))]
    l = [max(closes[i - 1] - closes[i], 0) for i in range(1, len(closes))]
    ag = sum(g[-p:]) / p
    al = sum(l[-p:]) / p
    return round(100 - 100 / (1 + ag / al), 1) if al > 0 else 100

def calc_macd(closes):
    if len(closes) < 26:
        return 0, 0
    e12 = calc_ema(closes, 12)
    e26 = calc_ema(closes, 26)
    macd = e12 - e26
    sig = macd * 0.2 + (e12 - e26) * 0.8
    return round(macd, 4), round(macd - sig, 4)

def calc_vwap(candles):
    tv = sum(c["v"] for c in candles)
    if tv == 0:
        return 0
    return round(sum(c["c"] * c["v"] for c in candles) / tv, 2)

def detect_fvg(candles):
    fvgs = []
    for i in range(len(candles) - 2):
        c1, c2, c3 = candles[i], candles[i + 1], candles[i + 2]
        if c3["l"] > c1["h"]:
            fvgs.append(f"BullFVG {c1['h']:.1f}-{c3['l']:.1f}")
        elif c3["h"] < c1["l"]:
            fvgs.append(f"BearFVG {c3['h']:.1f}-{c1['l']:.1f}")
    return fvgs[-2:] if fvgs else ["None"]

def detect_ob(candles):
    obs = []
    for i in range(2, len(candles) - 1):
        c, n = candles[i], candles[i + 1]
        if c["c"] < c["o"] and n["c"] > n["o"]:
            if (n["c"] - n["o"]) > (n["h"] - n["l"]) * 0.5:
                obs.append(f"BullOB {c['l']:.1f}-{c['h']:.1f}")
        elif c["c"] > c["o"] and n["c"] < n["o"]:
            if (n["o"] - n["c"]) > (n["h"] - n["l"]) * 0.5:
                obs.append(f"BearOB {c['l']:.1f}-{c['h']:.1f}")
    return obs[-2:] if obs else ["None"]

def detect_sweep(candles):
    if len(candles) < 5:
        return "None"
    highs = [c["h"] for c in candles[-10:]]
    lows = [c["l"] for c in candles[-10:]]
    last = candles[-1]
    ph = max(highs[:-1])
    pl = min(lows[:-1])
    if last["h"] > ph and last["c"] < ph:
        return f"Bear sweep {ph:.1f}"
    elif last["l"] < pl and last["c"] > pl:
        return f"Bull sweep {pl:.1f}"
    return "None"

def get_session():
    h = datetime.utcnow().hour
    if 2 <= h < 9:
        return "ASIA"
    elif 7 <= h < 12:
        return "LONDON"
    elif 12 <= h < 21:
        return "NEW YORK"
    else:
        return "OFF-HOURS"

def get_market_data():
    try:
        r = requests.get(
            "https://fapi.binance.com/fapi/v1/ticker/price",
            params={"symbol": SYMBOL}, timeout=10)
        price = float(r.json()["price"])
    except:
        price = 0.0
    try:
        r = requests.get(
            "https://fapi.binance.com/fapi/v1/premiumIndex",
            params={"symbol": SYMBOL}, timeout=10)
        funding = float(r.json().get("lastFundingRate", 0)) * 100
    except:
        funding = 0.0
    try:
        r = requests.get(
            "https://fapi.binance.com/fapi/v1/openInterest",
            params={"symbol": SYMBOL}, timeout=10)
        oi = float(r.json().get("openInterest", 0))
    except:
        oi = 0.0
    try:
        r = requests.get(
            "https://fapi.binance.com/fapi/v1/ticker/24hr",
            params={"symbol": SYMBOL}, timeout=10)
        chg24 = float(r.json().get("priceChangePercent", 0))
    except:
        chg24 = 0.0

    k4h = get_klines("4h", 30)
    k30m = get_klines("30m", 30)
    k15m = get_klines("15m", 20)
    k3m = get_klines("3m", 15)

    def summary(candles, label):
        if len(candles) < 5:
            return f"{label}: no data"
        closes = [c["c"] for c in candles]
        e200 = calc_ema(closes, min(200, len(closes)))
        rsi = calc_rsi(closes)
        vwap = calc_vwap(candles)
        pos = "Above" if closes[-1] > e200 else "Below"
        trend = "UP" if closes[-1] > closes[-5] else "DOWN"
        return (f"{label} P={closes[-1]:.1f} "
                f"E200={e200:.1f}({pos}) "
                f"RSI={rsi} VWAP={vwap} T={trend}")

    oi_trend = "FLAT"
    if len(k4h) >= 3:
        if k4h[-1]["v"] > k4h[-3]["v"] * 1.1:
            oi_trend = "RISING"
        elif k4h[-1]["v"] < k4h[-3]["v"] * 0.9:
            oi_trend = "FALLING"

    news = get_crypto_news()
    return {
        "price": price, "funding": funding,
        "oi": oi, "chg24": chg24,
        "session": get_session(),
        "oi_trend": oi_trend,
        "4h": summary(k4h, "4H"),
        "30m": summary(k30m, "30M"),
        "15m": summary(k15m, "15M"),
        "3m": summary(k3m, "3M"),
        "fvg": ", ".join(detect_fvg(k30m)),
        "ob": ", ".join(detect_ob(k30m)),
        "sweep": detect_sweep(k30m),
        "fvg_4h": ", ".join(detect_fvg(k4h)),
        "ob_4h": ", ".join(detect_ob(k4h)),
        "news": news,
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M"),
    }

# ============================================================
# MISTAKE MEMORY
# ============================================================

def get_mistakes():
    if not mistake_log:
        return "None yet."
    return " | ".join([f"{m['direction']}:{m['reason'][:25]}"
                       for m in mistake_log[-2:]])

def log_mistake(direction, reason):
    mistake_log.append({
        "time": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "direction": direction,
        "reason": reason,
    })
    if len(mistake_log) > 50:
        mistake_log[:] = mistake_log[-50:]

