def send_daily_report(m):
    global trades_since_last_msg
    today = datetime.now().strftime("%Y-%m-%d")
    td    = [t for t in paper_history if t["time"][:10] == today]
    wins  = sum(1 for t in paper_history if t["outcome"] == "WIN")
    losses = len(paper_history) - wins
    wr    = round(wins / max(len(paper_history), 1) * 100, 1)
    pnl   = round(sum(t["pnl"] for t in paper_history), 2)
    st    = "📈" if pnl >= 0 else "📉"
    bal   = get_balance()
    ai_row = (f"AI1{ai_status['AI1']} AI2{ai_status['AI2']} "
              f"AI3{ai_status['AI3']} AI4{ai_status['AI4']}\n"
              f"AI5{ai_status['AI5']} AI6{ai_status['AI6']} "
              f"AI7{ai_status['AI7']} AI8{ai_status['AI8']} "
              f"AI9{ai_status['AI9']}")
    send_telegram(
        f"📅 <b>DAILY REPORT — {today}</b>\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"🤖 AI STATUS:\n{ai_row}\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"⏱ Experience: {get_experience()}\n"
        f"📊 Today trades: {len(td)}\n"
        f"💰 Balance: ${bal:.2f}\n"
        f"💹 Total PnL: {st} <b>${pnl}</b>\n"
        f"🎯 WR: <b>{wr}%</b> | {wins}W/{losses}L\n"
        f"📈 Total trades(y): {len(paper_history)}\n"
        f"📚 Mistakes learned: {len(mistake_log)}\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"[TESTNET FAKE MONEY]")
    trades_since_last_msg = 0

def send_monthly_report():
    month  = datetime.now().strftime("%B %Y")
    wins   = sum(1 for t in paper_history if t["outcome"] == "WIN")
    losses = len(paper_history) - wins
    wr     = round(wins / max(len(paper_history), 1) * 100, 1)
    pnl    = round(sum(t["pnl"] for t in paper_history), 2)
    st     = "📈" if pnl >= 0 else "📉"
    best   = max((t["pnl"] for t in paper_history), default=0)
    worst  = min((t["pnl"] for t in paper_history), default=0)
    bal    = get_balance()
    ses    = ["ASIA","LONDON","NEW YORK"]
    ss     = {}
    for s in ses:
        st2 = [t for t in paper_history if t.get("session") == s]
        sw  = sum(1 for t in st2 if t["outcome"] == "WIN")
        ss[s] = round(sw / max(len(st2), 1) * 100, 1)
    best_ses = max(ss, key=ss.get)
    send_telegram(
        f"🏆 <b>MONTHLY REPORT — {month}</b>\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"⏱ Experience: {get_experience()}\n"
        f"💰 Balance: ${bal:.2f}\n"
        f"💹 PnL: {st} <b>${pnl}</b>\n"
        f"📊 Trades: {len(paper_history)}\n"
        f"🎯 WR: <b>{wr}%</b> | {wins}W/{losses}L\n"
        f"🏅 Best: +${best:.2f} | Worst: ${worst:.2f}\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"🌍 SESSIONS\n"
        f"🌏 ASIA: {ss['ASIA']}%\n"
        f"🇬🇧 LONDON: {ss['LONDON']}%\n"
        f"🗽 NEW YORK: {ss['NEW YORK']}%\n"
        f"🏆 Best: <b>{best_ses}</b>\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"📚 Mistakes learned: {len(mistake_log)}\n"
        f"{'✅ GREAT MONTH BRO!' if pnl > 0 else '📚 Keep learning!'}\n"
        f"[TESTNET FAKE MONEY]")

# ============================================================
# MAIN CYCLE
# ============================================================

def run_cycle():
    global cycle_count, last_daily_reported, last_monthly_reported

    cycle_count += 1
    print(f"\n{'='*40}")
    print(f"CYCLE #{cycle_count}: {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print(f"{'='*40}")

    check_commands()
    check_position()

    print("Fetching market...")
    m = get_market_data()
    if m["price"] == 0:
        print("No price. Skipping.")
        return
    print(f"ETH=${m['price']:.2f} | {m['session']}")

    if open_position:
        pos = get_open_pos()
        if pos:
            print(f"  Position open: {pos['direction']} PnL=${pos['pnl']:.2f}")
        return

    print("Running AIs...")
    results = [None] * 9

    print("  AI1 Macro...",   end=" ", flush=True)
    results[0] = ai1_macro(m)
    print(ai_status["AI1"]); time.sleep(5)

    print("  AI2 Tech...",    end=" ", flush=True)
    results[1] = ai2_technicals(m)
    print(ai_status["AI2"]); time.sleep(2)

    print("  AI3 Conf...",    end=" ", flush=True)
    results[2] = ai3_confluence(m, results[0], results[1])
    print(ai_status["AI3"]); time.sleep(5)

    print("  AI4 Risk...",    end=" ", flush=True)
    results[3] = ai4_risk(m)
    print(ai_status["AI4"]); time.sleep(2)

    print("  AI5 Smart...",   end=" ", flush=True)
    results[4] = ai5_smart_money(m, results[0])
    print(ai_status["AI5"]); time.sleep(5)

    print("  AI6 RL...",      end=" ", flush=True)
    results[5] = ai6_rl_coach()
    print(ai_status["AI6"]); time.sleep(2)

    print("  AI7 Edge...",    end=" ", flush=True)
    results[6] = ai7_edge_master(m, results[0])
    print(ai_status["AI7"]); time.sleep(5)

    print("  AI8 Umar...",    end=" ", flush=True)
    results[7] = ai8_umar(m, results[0])
    print(ai_status["AI8"]); time.sleep(2)

    print("  AI9 Logic...",   end=" ", flush=True)
    results[8] = ai9_super_controller(m, results[:8])
    print(ai_status["AI9"])

    direction, vote_pct = ai_vote(results)
    print(f"  Vote: {direction} {vote_pct}%")

    if direction != "NONE" and vote_pct >= MIN_VOTE_PCT:
        levels = get_levels(results, direction, m["price"])
        if levels:
            success = open_trade(
                direction, m["price"],
                levels["sl"], levels["tp1"], levels["tp2"])
            if success:
                msg = build_status_message(m, results, direction, vote_pct, levels)
                send_telegram(msg)
    else:
        print("  No trade this cycle")
        levels = None

    now        = datetime.now()
    today      = now.strftime("%Y-%m-%d")
    this_month = now.strftime("%Y-%m")
    hour       = now.hour
    day        = now.day
    last_day   = calendar.monthrange(now.year, now.month)[1]

    if hour == 20 and last_daily_reported != today:
        last_daily_reported = today
        send_daily_report(m)

    if day == last_day and hour == 20 and last_monthly_reported != this_month:
        last_monthly_reported = this_month
        send_monthly_report()

    del results
    gc.collect()
    print(f"Done. Next in {INTERVAL_MINUTES}min.")

# ============================================================
# MAIN
# ============================================================

def main():
    bal = get_balance()
    send_telegram(
        f"⚡ <b>ZEUS ORACLE v7 + HASSAIN AI — LIVE</b>\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"🤖 5 Groq AIs + 4 Logic AIs\n"
        f"🧠 AI9: Pure Logic — Never fails!\n"
        f"💬 HASSAIN AI: Your trading partner & best friend\n"
        f"💰 Balance: ${bal:.2f}\n"
        f"📊 Every {INTERVAL_MINUTES}min silent trading\n"
        f"📅 Daily report: 8PM\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"💬 JUST CHAT NATURALLY:\n"
        f"'Why no trades?' → AI explains\n"
        f"'Show balance' → AI shows status\n"
        f"'Any questions?'\n"
        f"━━━━━━━━━━━━━━━━━━\n"
        f"[TESTNET FAKE MONEY ONLY]\n"
        f"Started: {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print("ZEUS ORACLE v7 + HASSAIN AI started!")
    print("Natural chat enabled - talk like friends!")

    while True:
        try:
            run_cycle()
            time.sleep(INTERVAL_MINUTES * 60)
        except KeyboardInterrupt:
            send_telegram("🛑 Zeus + HASSAIN AI stopped.")
            if paper_history:
                send_monthly_report()
            print("Stopped.")
            break
        except MemoryError:
            gc.collect()
            send_telegram("⚠️ Memory cleared. Restart 2min...")
            time.sleep(120)
        except Exception as e:
            print(traceback.format_exc()[-200:])
            gc.collect()
            time.sleep(60)

if __name__ == "__main__":
    main()
