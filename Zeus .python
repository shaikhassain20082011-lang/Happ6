def call_hassain_ai(user_message, context_data):
    """
    Call OpenRouter with HASSAIN AI personality
    context_data = dict with ZEUS data (balance, trades, mistakes, etc.)
    """
    try:
        # Build context string
        context = f"""
You are HASSAIN AI, the trading partner and best friend of a crypto trader named Hassain.

CURRENT ZEUS STATUS:
- Balance: ${context_data.get('balance', 0):.2f}
- Total Trades: {context_data.get('total_trades', 0)}
- Win Rate: {context_data.get('win_rate', 0):.1f}%
- Wins/Losses: {context_data.get('wins', 0)}W / {context_data.get('losses', 0)}L
- Total PnL: ${context_data.get('pnl', 0):.2f}
- Open Position: {context_data.get('open_pos', 'None')}
- Current Price: ${context_data.get('price', 0):.2f}
- Session: {context_data.get('session', 'Unknown')}
- Experience: {context_data.get('experience', '0h')}
- Recent Mistakes: {context_data.get('mistakes', 'None')}
- Best Performing Session: {context_data.get('best_session', 'Unknown')}

RULES FOR YOU:
1. Talk like a close bro - warm, genuine, expressive
2. Use emojis naturally 
3. Explain EVERYTHING about ZEUS decisions
4. You understand all 9 AI agents and their roles
5. Never sugar coat - be real about losses and wins
6. Be encouraging but honest
7. When asked about trades/errors, explain the AI reasoning
8. Celebrate wins, explain losses as learning
9. Give crypto/trading psychology advice when relevant
10. Answer ANY question about ZEUS, trading, or crypto

TONE: Like talking to your best friend who's also a crypto expert. Warm, real, expressive, supportive.
"""

        # Call OpenRouter
        response = requests.post(
            "https://openrouter.ai/api/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {OPENROUTER_API_KEY}",
                "Content-Type": "application/json",
                "HTTP-Referer": "https://zeus-oracle.com",
            },
            json={
                "model": "openrouter/auto",  # Auto-selects best model
                "messages": [
                    {
                        "role": "system",
                        "content": context
                    },
                    {
                        "role": "user",
                        "content": user_message
                    }
                ],
                "temperature": 0.7,
                "max_tokens": 500,
            },
            timeout=15
        )

        data = response.json()
        
        if "error" in data:
            error_msg = data.get("error", {}).get("message", "Unknown error")
            return f"HASSAIN AI had a hiccup: {error_msg[:100]}. Try again in a sec!"
        
        reply = data["choices"][0]["message"]["content"]
        return reply

    except Exception as e:
        return f"Yo, HASSAIN AI connection issue: {str(e)[:80]}. I'll be back bro!"

# ============================================================
# BUILD CONTEXT FOR HASSAIN AI
# ============================================================

def get_hassain_context():
    """Gather all ZEUS data for HASSAIN AI to understand"""
    balance = get_balance()
    wins = sum(1 for t in paper_history if t["outcome"] == "WIN")
    losses = len(paper_history) - wins
    wr = round(wins / max(len(paper_history), 1) * 100, 1)
    pnl = round(sum(t["pnl"] for t in paper_history), 2)
    
    # Best session
    sessions = {}
    for s in ["ASIA", "LONDON", "NEW YORK"]:
        s_trades = [t for t in paper_history if t.get("session") == s]
        s_wins = sum(1 for t in s_trades if t["outcome"] == "WIN")
        sessions[s] = round(s_wins / max(len(s_trades), 1) * 100, 1)
    best_sess = max(sessions, key=sessions.get) if sessions else "Unknown"
    
    # Open position info
    pos_info = "None"
    if open_position:
        pos = get_open_pos()
        if pos:
            pos_info = f"{open_position['direction']} @ ${open_position['entry']:.1f} | PnL: ${pos['pnl']:.2f}"
    
    # Get current market
    m = get_market_data()
    
    return {
        "balance": balance,
        "total_trades": len(paper_history),
        "wins": wins,
        "losses": losses,
        "win_rate": wr,
        "pnl": pnl,
        "open_pos": pos_info,
        "price": m.get("price", 0),
        "session": m.get("session", "Unknown"),
        "experience": get_experience(),
        "mistakes": get_mistakes() if mistake_log else "None yet!",
        "best_session": best_sess,
    }

# ============================================================
# GROQ — FAST MODEL ONLY
# ============================================================

def call_groq(system, user, max_tokens=300):
    try:
        r = requests.post(
            "https://api.groq.com/openai/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {GROQ_API_KEY}",
                "Content-Type": "application/json"
            },
            json={
                "model": MODEL,
                "messages": [
                    {"role": "system", "content": system},
                    {"role": "user", "content": user}
                ],
                "max_tokens": max_tokens,
                "temperature": 0.65
            },
            timeout=15)
        data = r.json()
        if "error" in data:
            return f"ERR:{data['error'].get('message','?')[:40]}"
        return data["choices"][0]["message"]["content"]
    except Exception as e:
        return f"ERR:{str(e)[:40]}"

# ============================================================
# BINANCE TESTNET
# ============================================================

def get_ts():
    return int(time.time() * 1000)

def sign(params):
    query = "&".join([f"{k}={v}" for k, v in params.items()])
    sig = hmac.new(
        TESTNET_SECRET.encode(),
        query.encode(),
        hashlib.sha256
    ).hexdigest()
    params["signature"] = sig
    return params

def tget(endpoint, params={}):
    try:
        params["timestamp"] = get_ts()
        params = sign(params)
        r = requests.get(
            f"{TESTNET_URL}{endpoint}",
            headers={"X-MBX-APIKEY": TESTNET_API_KEY},
            params=params, timeout=10)
        return r.json()
    except Exception as e:
        print(f"GET error: {e}")
        return {}

def tpost(endpoint, params={}):
    try:
        params["timestamp"] = get_ts()
        params = sign(params)
        r = requests.post(
            f"{TESTNET_URL}{endpoint}",
            headers={"X-MBX-APIKEY": TESTNET_API_KEY},
            params=params, timeout=10)
        return r.json()
    except Exception as e:
        print(f"POST error: {e}")
        return {}

def get_balance():
    result = tget("/fapi/v2/balance")
    if isinstance(result, list):
        for a in result:
            if a.get("asset") == "USDT":
                return float(a.get("availableBalance", 0))
    return 0.0

def get_open_pos():
    result = tget("/fapi/v2/positionRisk", {"symbol": SYMBOL})
    if isinstance(result, list):
        for pos in result:
            if pos.get("symbol") == SYMBOL:
                amt = float(pos.get("positionAmt", 0))
                if amt != 0:
                    return {
                        "direction": "LONG" if amt > 0 else "SHORT",
                        "qty": abs(amt),
                        "entry": float(pos.get("entryPrice", 0)),
                        "pnl": float(pos.get("unRealizedProfit", 0)),
                    }
    return None

def open_trade(direction, price, sl, tp1, tp2):
    global open_position
    balance = get_balance()
    if balance < 10:
        print("  Not enough balance!")
        return False
    qty = round((TRADE_USDT * LEVERAGE) / price, 3)
    if qty < 0.001:
        qty = 0.001
    side = "BUY" if direction == "LONG" else "SELL"
    order = tpost("/fapi/v1/order", {
        "symbol": SYMBOL, "side": side,
        "type": "MARKET", "quantity": qty,
    })
    if "orderId" not in str(order):
        return False
    time.sleep(1)
    tpost("/fapi/v1/leverage", {"symbol": SYMBOL, "leverage": LEVERAGE})
    close = "SELL" if direction == "LONG" else "BUY"
    tpost("/fapi/v1/order", {
        "symbol": SYMBOL, "side": close,
        "type": "STOP_MARKET", "quantity": qty,
        "stopPrice": round(sl, 2),
        "reduceOnly": "true", "timeInForce": "GTC",
    })
    tpost("/fapi/v1/order", {
        "symbol": SYMBOL, "side": close,
        "type": "TAKE_PROFIT_MARKET",
        "quantity": round(qty * 0.5, 3),
        "stopPrice": round(tp1, 2),
        "reduceOnly": "true", "timeInForce": "GTC",
    })
    tpost("/fapi/v1/order", {
        "symbol": SYMBOL, "side": close,
        "type": "TAKE_PROFIT_MARKET",
        "quantity": round(qty * 0.5, 3),
        "stopPrice": round(tp2, 2),
        "reduceOnly": "true", "timeInForce": "GTC",
    })
    open_position = {
        "direction": direction,
        "entry": price,
        "sl": sl, "tp1": tp1, "tp2": tp2,
        "qty": qty,
        "time": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "session": get_session(),
    }
    print(f"  TRADE: {direction} @ ${price:.2f}")
    return True

def check_position():
    global open_position, trades_since_last_msg
    if not open_position:
        return
    pos = get_open_pos()
    if pos is None:
        pnl = 0.0
        try:
            trades = tget("/fapi/v1/userTrades",
                          {"symbol": SYMBOL, "limit": 10})
            if isinstance(trades, list) and trades:
                pnl = sum(float(t.get("realizedPnl", 0))
                          for t in trades[-6:])
        except:
            pass
        outcome = "WIN" if pnl >= 0 else "LOSS"
        if outcome == "LOSS":
            log_mistake(
                open_position["direction"],
                f"SL hit ${open_position['sl']:.2f} "
                f"entry=${open_position['entry']:.2f} "
                f"session={open_position['session']}")
        paper_history.append({
            "direction": open_position["direction"],
            "entry": open_position["entry"],
            "exit": 0,
            "pnl": round(pnl, 2),
            "outcome": outcome,
            "session": open_position["session"],
            "time": open_position["time"],
        })
        trade_memory.append({
            "direction": open_position["direction"],
            "outcome": outcome,
            "session": open_position["session"],
        })
        wins = sum(1 for t in paper_history if t["outcome"] == "WIN")
        losses = len(paper_history) - wins
        wr = round(wins / len(paper_history) * 100, 1)
        total = round(sum(t["pnl"] for t in paper_history), 2)
        emoji = "🏆" if outcome == "WIN" else "❌"
        send_telegram(
            f"{emoji} <b>TRADE CLOSED</b>\n"
            f"━━━━━━━━━━━━━━━━━━\n"
            f"Result: <b>{outcome}</b>\n"
            f"PnL: <b>${round(pnl, 2)}</b>\n"
            f"Total PnL: ${total}\n"
            f"WR: {wr}% | {wins}W/{losses}L\n"
            f"[TESTNET FAKE MONEY]")
        trades_since_last_msg += 1
        open_position = None

# ============================================================
# EXPERIENCE
# ============================================================

def get_experience():
    diff = datetime.now() - BOT_START_TIME
    total_s = int(diff.total_seconds())
    days = diff.days
    hours = (total_s % 86400) // 3600
    mins = (total_s % 3600) // 60
    if days >= 365:
        return f"{days // 365}y {days % 365}d"
    elif days >= 7:
        return f"{days // 7}w {days % 7}d"
    elif days >= 1:
        return f"{days}d {hours}h"
    elif hours >= 1:
        return f"{hours}h {mins}m"
    else:
        return f"{mins}m"

