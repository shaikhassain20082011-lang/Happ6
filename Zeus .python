    global ai_status
    sys = "Smart money tracker. Whale movements. Institutional flow."
    p = f"""AI1:{ai1[:80]}
Funding={m['funding']:.4f}% OI={m['oi_trend']}
Price={m['price']:.2f} 24h={m['chg24']:.2f}%

OUTPUT:
SMART_MONEY:[Bull/Bear/Neutral]
WHALE:[Accumulating/Distributing/Neutral]
DIRECTION:[LONG/SHORT/NONE]
SQUEEZE:[YES/NO]"""
    result = call_groq(sys, p, 120)
    ai_status["AI5"] = "✅" if "ERR" not in result else "❌"
    return result

def ai6_rl_coach():
    global ai_status
    recent = trade_memory[-10:] if trade_memory else []
    wins = sum(1 for t in recent if t.get("outcome") == "WIN")
    losses = sum(1 for t in recent if t.get("outcome") == "LOSS")
    wr = round(wins / max(len(recent), 1) * 100, 1)

    session_wins = {}
    for sess in ["ASIA","LONDON","NEW YORK"]:
        s_trades = [t for t in trade_memory if t.get("session") == sess]
        s_wins   = sum(1 for t in s_trades if t.get("outcome") == "WIN")
        session_wins[sess] = round(s_wins / max(len(s_trades), 1) * 100, 1)

    best_session = max(session_wins, key=session_wins.get) if session_wins else "UNKNOWN"

    direction = "NONE"
    if wr >= 60:
        direction = "LONG"
    elif wr < 40 and len(recent) > 3:
        direction = "NONE"

    result = (f"WIN_RATE:{wr}%\n"
              f"WINS:{wins} LOSSES:{losses}\n"
              f"BEST_SESSION:{best_session}\n"
              f"DIRECTION:{direction}\n"
              f"SKILL:{min(100, int(wr))} /100")
    ai_status["AI6"] = "✅"
    return result

def ai7_edge_master(m, ai1):
    global ai_status
    recent = trade_memory[-20:] if trade_memory else []
    edge = "Building..."
    if recent:
        wins = sum(1 for t in recent if t.get("outcome") == "WIN")
        wr   = wins / len(recent)
        exp  = round((wr * 1.5) - ((1 - wr) * 1.0), 3)
        edge = f"WR={round(wr*100,1)}% Exp={exp}"
    sys = "Edge master. Positive expectancy only. Fast answer."
    p = f"""AI1:{ai1[:80]}
EDGE:{edge}
Price={m['price']:.2f} Session={m['session']}
FVG={m['fvg']} Sweep={m['sweep']}

OUTPUT:
EDGE:[YES/NO]
SCORE:[0-100]%
DIRECTION:[LONG/SHORT/NONE]"""
    result = call_groq(sys, p, 100)
    ai_status["AI7"] = "✅" if "ERR" not in result else "❌"
    return result

